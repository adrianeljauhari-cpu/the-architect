# Copy to .env and fill. Never commit .env. See blueprint §10 for "Required by step".
NODE_ENV=development

# Postgres — local dev + integration tests point at the docker compose service (§19.6).
# Production DATABASE_URL comes from Supabase.
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
TEST_DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# Ingest <-> sync agent HMAC (generate: openssl rand -hex 32)
SYNC_SHARED_SECRET=
INGEST_URL=http://localhost:3000/api/ingest

# Profit Plus SQL Server (read-only user) — used by the on-prem agent only
PROFIT_SQL_HOST=
PROFIT_SQL_USER=
PROFIT_SQL_PASSWORD=
PROFIT_SQL_DATABASE=

# Better Auth session signing (generate: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Resend transactional email
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
PROOF_NOTIFY_EMAIL=

# Supabase Storage (product photos, payment proofs)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
